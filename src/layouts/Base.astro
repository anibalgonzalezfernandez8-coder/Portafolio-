---
const { title = 'Archivo' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Inter:wght@300;400&display=swap" />
</head>
<body>
  <header class="top">
    <a class="brand" href={`${base}/`}>Archivo</a>
    <a class="lk" href={`${base}/`}>Exposiciones</a>
  </header>
  <main><slot /></main>
  <div class="lb" id="lb" hidden>
    <button class="c" id="lc" aria-label="Cerrar">×</button>
    <button class="p" id="lp" aria-label="Anterior">‹</button>
    <img id="li" alt="" />
    <button class="n" id="ln" aria-label="Siguiente">›</button>
    <small id="lt"></small>
  </div>
  <script>
    const lb = document.getElementById('lb')!, li = document.getElementById('li') as HTMLImageElement, lt = document.getElementById('lt')!;
    let list: string[] = [], i = 0;
    const show = (n: number) => { i = (n + list.length) % list.length; li.src = list[i]; lt.textContent = `${i + 1} / ${list.length}`; lb.hidden = false; };
    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.ph') as HTMLElement | null;
      if (!b) return;
      const all = [...b.parentElement!.querySelectorAll<HTMLElement>('.ph')];
      list = all.map((x) => x.dataset.big!);
      show(all.indexOf(b));
    });
    const close = () => (lb.hidden = true);
    document.getElementById('lc')!.onclick = close;
    document.getElementById('lp')!.onclick = () => show(i - 1);
    document.getElementById('ln')!.onclick = () => show(i + 1);
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    let x0 = 0;
    lb.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    lb.addEventListener('touchend', (e) => { const d = e.changedTouches[0].clientX - x0; if (Math.abs(d) > 50) show(i + (d < 0 ? 1 : -1)); });
  </script>
</body>
</html>
<style is:global>
:root{--bg:#121110;--fg:#eeebe5;--mu:#8d8a84;--ln:#2a2927;--sf:"Cormorant Garamond",Georgia,serif;--ss:Inter,system-ui,sans-serif;padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}
@media (prefers-color-scheme:light){:root{--bg:#f6f4f0;--fg:#161514;--mu:#8a857d;--ln:#dcd8d1}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:300 15px/1.6 var(--ss)}
a{color:inherit;text-decoration:none}
.top{display:flex;justify-content:space-between;align-items:center;padding:18px 22px}
.brand{font:600 22px var(--sf);letter-spacing:.18em;text-transform:uppercase}
.lk{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--mu)}
main{max-width:1100px;margin:0 auto;padding:6px 22px 80px}
.eyebrow{margin-top:40px;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--mu)}
.hero{font:400 clamp(44px,13vw,140px)/1 var(--sf);margin:14px 0 10px}
.sub{color:var(--mu);max-width:520px;margin:0 0 32px}
.cv{position:relative;display:block;aspect-ratio:4/5;overflow:hidden;margin:0 0 18px;background:var(--ln)}
@media(min-width:700px){.cv{aspect-ratio:16/8}}
.cv picture,.cv img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cv i{position:absolute;inset:0;background:linear-gradient(transparent 45%,rgba(0,0,0,.65))}
.cv div{position:absolute;left:22px;bottom:20px;color:#fff}
.cv b{display:block;font:400 clamp(30px,6vw,52px)/1 var(--sf)}
.cv span{font-size:12px;letter-spacing:.16em;text-transform:uppercase;opacity:.85}
.ti{font:400 clamp(34px,7vw,60px)/1.1 var(--sf);margin:30px 0 6px}
.tx{color:var(--mu);max-width:560px;margin:0 0 20px}
.ph{display:block;width:100%;border:0;padding:0;background:var(--ln);overflow:hidden;position:relative;cursor:zoom-in}
.ph picture,.ph img{display:block;width:100%;height:100%;object-fit:cover}
.L{display:grid;gap:14px;margin-top:10px}
.L-cover{grid-template-columns:1fr}
.L-cover .ph:first-child{aspect-ratio:3/4;max-height:88vh}
.L-cover .ph:first-child::after{content:attr(data-t);position:absolute;left:20px;right:20px;bottom:18px;color:#fff;font:400 clamp(44px,12vw,120px)/.95 var(--sf);text-align:left;text-shadow:0 2px 30px rgba(0,0,0,.35);pointer-events:none}
.L-cover .ph:not(:first-child){aspect-ratio:4/3}
@media(min-width:700px){.L-cover{grid-template-columns:repeat(3,1fr)}.L-cover .ph:first-child{grid-column:1/-1;aspect-ratio:16/9}}
.L-collage{grid-template-columns:repeat(6,1fr);grid-auto-rows:70px}
.L-collage .ph:nth-child(5n+1){grid-column:span 4;grid-row:span 5}
.L-collage .ph:nth-child(5n+2){grid-column:span 2;grid-row:span 3}
.L-collage .ph:nth-child(5n+3){grid-column:span 2;grid-row:span 2}
.L-collage .ph:nth-child(5n+4),.L-collage .ph:nth-child(5n+5){grid-column:span 3;grid-row:span 3}
.L-strip{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:28px;padding:20px 0}
.L-strip .ph{flex:none;width:auto;height:min(62vh,520px);scroll-snap-align:center}
.L-strip .ph picture,.L-strip .ph img{width:auto}
.L-single{gap:90px;padding:40px 0}
.L-single .ph{width:min(88%,640px);margin:0 auto;background:none}
.L-single .ph img{height:auto}
.L-mosaic{grid-template-columns:repeat(2,1fr);gap:6px}
.L-mosaic .ph{aspect-ratio:1}
@media(min-width:700px){.L-mosaic{grid-template-columns:repeat(4,1fr)}}
.L-pin{display:block;column-count:2;column-gap:10px}
@media(min-width:700px){.L-pin{column-count:4}}
.L-pin .ph{break-inside:avoid;margin-bottom:10px;border-radius:14px;background:none}
.L-pin .ph img{height:auto}
.L-ig{grid-template-columns:repeat(3,1fr);gap:3px}
.L-ig .ph{aspect-ratio:4/5}
.L-zara{grid-template-columns:1fr 1fr;gap:56px 16px;padding:20px 0}
.L-zara .ph{background:none}
.L-zara .ph img{height:auto}
.L-zara .ph:nth-child(3n+1){grid-column:1/-1}
.L-flickr{display:flex;flex-wrap:wrap;gap:4px}
.L-flickr .ph{width:calc(var(--r)*200px);flex-grow:calc(var(--r)*100);height:200px}
.lb{position:fixed;inset:0;background:#000;z-index:30;display:flex;align-items:center;justify-content:center}
.lb[hidden]{display:none}
.lb img{max-width:96vw;max-height:88vh;object-fit:contain}
.lb button{position:absolute;background:none;border:0;color:#fff;font-size:30px;padding:16px;opacity:.75;cursor:pointer}
.lb .c{top:0;right:4px}.lb .p{left:0}.lb .n{right:0}
.lb small{position:absolute;bottom:14px;color:#bbb;font-size:12px;letter-spacing:.14em}
</style>
